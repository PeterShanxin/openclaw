# Core Configuration
OPENCLAW_IMAGE=openclaw:local
OPENCLAW_CONFIG_DIR=./openclaw-config
OPENCLAW_WORKSPACE_DIR=./openclaw-workspace
OPENCLAW_GATEWAY_PORT=18789

# Authentication (choose one)
# Option A: GLM API (Z.AI)
ZAI_API_KEY=your_glm_api_key_here

# Option B: Qwen OAuth (free tier)
# (Enable via plugin after setup)

# Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Gateway Token (generate random string)
OPENCLAW_GATEWAY_TOKEN=random_secure_string_here

# Google Maps Grounding Lite API key (optional)
GOOGLE_MAPS_API_KEY=your_google_maps_grounding_lite_key_here

# Moltbook (optional)
# Used by openclaw-workspace/skills/moltbook-client/*
MOLTBOOK_AGENT_ID=your_moltbook_agent_id_here
MOLTBOOK_API_KEY=your_moltbook_api_key_here
