# Environment for systemd services (openclaw-gateway + chrome-headless)
#
# Keep this file root-owned and chmod 600:
#   sudo chown root:root /etc/openclaw/moltbot.env
#   sudo chmod 600 /etc/openclaw/moltbot.env

# OpenClaw paths
OPENCLAW_STATE_DIR=/var/lib/openclaw
OPENCLAW_WORKSPACE_DIR=/var/lib/openclaw/workspace
OPENCLAW_CONFIG_PATH=/var/lib/openclaw/openclaw.json

# Optional: extra envs (only if you rely on them)
# BRAVE_API_KEY=
# GOOGLE_MAPS_API_KEY=

